# Copy to .env and fill in. Never commit the real .env.
# The backend reads hw4/.env first, then falls back to the parent folder's .env.

# Portkey key for the course model (OpenAI-compatible endpoint).
PORTKEY_API_KEY=your-portkey-key-here

# Random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-string
